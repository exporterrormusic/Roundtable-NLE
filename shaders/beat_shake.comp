#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform writeonly image2D outputImage;
layout(binding = 1)        uniform sampler2D inputImage;

layout(push_constant) uniform PushConstants {
    int   width;
    int   height;
    int   paramCount;
    int   _pad;
    float params[16];
    // [0] amount (px)   [14] pulse (0–1)   [15] seconds
} pc;

void main()
{
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= pc.width || px.y >= pc.height) return;

    vec2 res = vec2(pc.width, pc.height);
    vec2 uv  = (vec2(px) + 0.5) / res;

    float amt = pc.params[0] * pc.params[14];           // shake magnitude (px)
    float t   = pc.params[15];
    vec2  dir = vec2(sin(t * 97.0), cos(t * 113.0));    // fast wobble direction
    vec2  suv = clamp(uv + dir * amt / res, 0.0, 1.0);

    imageStore(outputImage, px, texture(inputImage, suv));
}
