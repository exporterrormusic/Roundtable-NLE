#version 450
// YUVA444P12LE → BGRA color-space conversion compute shader.
//
// This is FFmpeg's decode output for ProRes 4444 (with alpha): four PLANAR
// planes, all at full resolution (4:4:4 — no chroma subsampling), each sample
// a 12-bit value stored in the LOW 12 bits of a little-endian 16-bit word
// (range 0..4095; high 4 bits zero).  Note this differs from P010, which
// stores 10-bit data in the HIGH bits.
//
// Planar layout (all W × H):
//   Plane 0 (Y):  R16_UNORM   luma
//   Plane 1 (U):  R16_UNORM   Cb (full res)
//   Plane 2 (V):  R16_UNORM   Cr (full res)
//   Plane 3 (A):  R16_UNORM   alpha (full range)
//
// BT.709 color matrix (HD standard), studio-swing expansion identical to the
// 8-bit path once samples are normalised to [0,1] — range scaling is bit-depth
// independent.  Must match the CPU sws_scale fallback (BT.709, limited→full)
// so frames from either path are interchangeable in the cache.

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D yPlane;   // R16_UNORM, full res
layout(binding = 1) uniform sampler2D uPlane;   // R16_UNORM, full res (Cb)
layout(binding = 2) uniform sampler2D vPlane;   // R16_UNORM, full res (Cr)
layout(binding = 3) uniform sampler2D aPlane;   // R16_UNORM, full res (alpha)

layout(binding = 4, rgba8) uniform writeonly image2D outputImage;

layout(push_constant) uniform PushConstants {
    int width;
    int height;
} pc;

// 12-bit value lives in the low 12 bits of the 16-bit word, so a UNORM
// sampler returns value/65535 in [0, 4095/65535].  Rescale to [0,1].
const float k12bitToUnit = 65535.0 / 4095.0;   // ≈ 16.0037

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= pc.width || pixel.y >= pc.height) return;

    // Full-resolution, co-sited planes — sample all four at the pixel centre.
    vec2 uv = (vec2(pixel) + 0.5) / vec2(pc.width, pc.height);

    float y = texture(yPlane, uv).r * k12bitToUnit;
    float u = texture(uPlane, uv).r * k12bitToUnit;
    float v = texture(vPlane, uv).r * k12bitToUnit;
    float a = texture(aPlane, uv).r * k12bitToUnit;   // alpha is full range

    // Studio-swing → full range (BT.709), same constants as the 8-bit shaders.
    float y_scaled = clamp((y - 0.0627) * 1.1644, 0.0, 1.0);
    float cb = (u - 0.50196) * 1.13839;
    float cr = (v - 0.50196) * 1.13839;

    float r = clamp(y_scaled + 1.5748 * cr,                       0.0, 1.0);
    float g = clamp(y_scaled - 0.1873 * cb - 0.4681 * cr,         0.0, 1.0);
    float b = clamp(y_scaled + 1.8556 * cb,                       0.0, 1.0);

    // Output BGRA (matches Qt ARGB32 byte order on little-endian) with the
    // real alpha channel preserved (straight alpha — premultiply happens
    // downstream where required).
    imageStore(outputImage, pixel, vec4(b, g, r, clamp(a, 0.0, 1.0)));
}
