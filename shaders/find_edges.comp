#version 450
// Find Edges (Premiere Stylize): Sobel edges per channel. Default output
// is dark lines on white, like Premiere; Invert gives bright lines on black.
//   [0] Invert (toggle)  [1] Blend With Original (0-100 %)
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform writeonly image2D outputImage;
layout(binding = 1) uniform sampler2D inputImage;

layout(push_constant) uniform PushConstants {
    int   width;
    int   height;
    int   paramCount;
    int   _pad;
    float params[16];
} pc;

vec3 s(vec2 uv, vec2 o) { return texture(inputImage, uv + o).rgb; }

void main()
{
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= pc.width || px.y >= pc.height) return;
    vec2 res = vec2(pc.width, pc.height);
    vec2 uv  = (vec2(px) + 0.5) / res;
    vec2 e   = 1.0 / res;
    vec4 src = texture(inputImage, uv);

    vec3 tl = s(uv, vec2(-e.x, -e.y)), t = s(uv, vec2(0, -e.y)), tr = s(uv, vec2(e.x, -e.y));
    vec3 l  = s(uv, vec2(-e.x, 0)),                                r  = s(uv, vec2(e.x, 0));
    vec3 bl = s(uv, vec2(-e.x, e.y)),  b = s(uv, vec2(0, e.y)),    br = s(uv, vec2(e.x, e.y));
    vec3 gx = (tr + 2.0 * r + br) - (tl + 2.0 * l + bl);
    vec3 gy = (bl + 2.0 * b + br) - (tl + 2.0 * t + tr);
    vec3 edge = clamp(sqrt(gx * gx + gy * gy), 0.0, 1.0);

    bool invert = pc.params[0] > 0.5;
    vec3 outC = invert ? edge : 1.0 - edge;
    float blend = clamp(pc.params[1] / 100.0, 0.0, 1.0);
    imageStore(outputImage, px, vec4(mix(outC, src.rgb, blend), src.a));
}
