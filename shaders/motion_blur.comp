#version 450
// Directional Blur and Radial Blur (Premiere Blur & Sharpen); [0] is the
// hidden mode.
//   0 Directional: [1] Direction (deg)  [2] Blur Length (px)
//   1 Radial:      [1] Amount (0-100)  [2] Type (0 Spin, 1 Zoom)
//                  [3] Center X (-1..1)  [4] Center Y (-1..1)
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform writeonly image2D outputImage;
layout(binding = 1) uniform sampler2D inputImage;

layout(push_constant) uniform PushConstants {
    int   width;
    int   height;
    int   paramCount;
    int   _pad;
    float params[16];
} pc;

const int TAPS = 48;

void main()
{
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= pc.width || px.y >= pc.height) return;
    vec2 res = vec2(pc.width, pc.height);
    vec2 p   = vec2(px) + 0.5;
    int mode = int(pc.params[0] + 0.5);

    vec4 acc = vec4(0.0);
    if (mode == 0) {
        float a = radians(pc.params[1]);
        float len = max(pc.params[2], 0.0);
        if (len < 0.5) { imageStore(outputImage, px, texture(inputImage, p / res)); return; }
        vec2 dir = vec2(cos(a), -sin(a)) * len;
        for (int i = 0; i < TAPS; ++i) {
            float t = float(i) / float(TAPS - 1) - 0.5;   // centred on the pixel
            acc += texture(inputImage, clamp((p + dir * t) / res, 0.0, 1.0));
        }
    } else {
        float amount = clamp(pc.params[1], 0.0, 100.0) / 100.0;
        bool  zoom   = pc.params[2] > 0.5;
        vec2  c = vec2(0.5 + 0.5 * pc.params[3], 0.5 + 0.5 * pc.params[4]) * res;
        if (amount <= 0.0) { imageStore(outputImage, px, texture(inputImage, p / res)); return; }
        vec2 d = p - c;
        for (int i = 0; i < TAPS; ++i) {
            float t = float(i) / float(TAPS - 1) - 0.5;
            vec2 q;
            if (zoom) {
                q = c + d * (1.0 + t * amount * 0.5);
            } else {
                float ang = t * amount * 0.6;          // up to ~±17° of spin
                float cs = cos(ang), sn = sin(ang);
                q = c + vec2(cs * d.x - sn * d.y, sn * d.x + cs * d.y);
            }
            acc += texture(inputImage, clamp(q / res, 0.0, 1.0));
        }
    }
    imageStore(outputImage, px, acc / float(TAPS));
}
