#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform writeonly image2D outputImage;
layout(binding = 1)        uniform sampler2D inputImage;

layout(push_constant) uniform PushConstants {
    int   width;
    int   height;
    int   paramCount;
    int   _pad;
    float params[16];
    // [0] intensity [1] tearAmount [2] frequency [3] mirror [4] seed
    // [15] clip-local seconds
} pc;

float hash21(vec2 p){ vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }

void main()
{
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= pc.width || px.y >= pc.height) return;

    vec2 uv = (vec2(px) + 0.5) / vec2(pc.width, pc.height);

    float intensity  = pc.params[0];
    float tearAmount = pc.params[1];
    float freq       = max(pc.params[2], 1.0);
    float mirror     = pc.params[3];
    float seed       = pc.params[4];
    float t          = pc.params[15];

    float band = floor(uv.y * freq);
    float tb   = floor(t * 8.0);                 // tears re-roll ~8 Hz
    float r    = hash21(vec2(band, tb) + seed);

    vec2 suv = uv;
    if (r > 1.0 - intensity) {
        float shift = (hash21(vec2(band, tb) * 1.7 + seed) - 0.5) * tearAmount;
        suv.x = uv.x + shift;
        if (hash21(vec2(band, tb) * 2.9 + seed) < mirror)
            suv.x = 1.0 - suv.x + shift;         // occasional mirrored slice
    }

    suv = clamp(suv, 0.0, 1.0);
    imageStore(outputImage, px, texture(inputImage, suv));
}
