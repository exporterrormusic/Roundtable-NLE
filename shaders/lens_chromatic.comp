#version 450
// Chromatic Aberration (lens): red and blue separate radially from the
// centre, growing toward the edges like a real lens (unlike Chromatic
// Split, which shifts the whole frame in one direction).
//   [0] Amount (px at the frame corner)  [1] Center X (-1..1)
//   [2] Center Y (-1..1)                 [3] Falloff (1 = linear, 3 = edges only)
//   [4] Smoothness (0..1: spread each channel over several taps)
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform writeonly image2D outputImage;
layout(binding = 1) uniform sampler2D inputImage;

layout(push_constant) uniform PushConstants {
    int   width;
    int   height;
    int   paramCount;
    int   _pad;
    float params[16];
} pc;

void main()
{
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= pc.width || px.y >= pc.height) return;

    vec2 res = vec2(pc.width, pc.height);
    vec2 uv  = (vec2(px) + 0.5) / res;
    vec4 src = texture(inputImage, uv);

    float amount  = pc.params[0];
    vec2  center  = vec2(0.5 + 0.5 * pc.params[1], 0.5 + 0.5 * pc.params[2]);
    float falloff = max(pc.params[3], 0.1);
    float smooth_ = clamp(pc.params[4], 0.0, 1.0);
    if (amount <= 0.0) { imageStore(outputImage, px, src); return; }

    // Radius normalised so the farthest corner from the centre is 1.
    vec2 d = (uv - center) * res;
    vec2 far = max(center, 1.0 - center) * res;
    float r = clamp(length(d) / max(length(far), 1.0), 0.0, 1.0);
    vec2 dir = length(d) > 0.0 ? normalize(d) : vec2(0.0);
    vec2 off = dir * amount * pow(r, falloff) / res;

    const int TAPS = 5;
    float red = 0.0, blue = 0.0, aR = 0.0, aB = 0.0;
    for (int i = 0; i < TAPS; ++i) {
        float t = (TAPS == 1) ? 1.0 : mix(1.0, float(i + 1) / float(TAPS), smooth_);
        vec4 sr = texture(inputImage, clamp(uv + off * t, 0.0, 1.0));
        vec4 sb = texture(inputImage, clamp(uv - off * t, 0.0, 1.0));
        red += sr.r; aR += sr.a;
        blue += sb.b; aB += sb.a;
    }
    red /= float(TAPS); blue /= float(TAPS); aR /= float(TAPS); aB /= float(TAPS);
    float alpha = max(src.a, max(aR, aB));
    imageStore(outputImage, px, vec4(red, src.g, blue, alpha));
}
