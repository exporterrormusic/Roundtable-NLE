#version 450
// Emboss / Color Emboss (Premiere Stylize).
//   [0] Direction (deg)  [1] Relief (px)  [2] Contrast (%)
//   [3] Blend With Original (0-100 %)  [4] Color Emboss (toggle: keep colour)
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform writeonly image2D outputImage;
layout(binding = 1) uniform sampler2D inputImage;

layout(push_constant) uniform PushConstants {
    int   width;
    int   height;
    int   paramCount;
    int   _pad;
    float params[16];
} pc;

void main()
{
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= pc.width || px.y >= pc.height) return;
    vec2 res = vec2(pc.width, pc.height);
    vec2 uv  = (vec2(px) + 0.5) / res;
    vec4 src = texture(inputImage, uv);

    float ang      = radians(pc.params[0]);
    float relief   = max(pc.params[1], 0.0);
    float contrast = pc.params[2] / 100.0;
    float blend    = clamp(pc.params[3] / 100.0, 0.0, 1.0);
    bool  colorize = pc.params[4] > 0.5;

    vec2 off = vec2(cos(ang), -sin(ang)) * relief / res;
    vec3 a = texture(inputImage, clamp(uv + off, 0.0, 1.0)).rgb;
    vec3 b = texture(inputImage, clamp(uv - off, 0.0, 1.0)).rgb;
    vec3 diff = (a - b) * contrast;

    vec3 outC;
    if (colorize) {
        outC = clamp(src.rgb + diff, 0.0, 1.0);
    } else {
        float g = dot(diff, vec3(0.2126, 0.7152, 0.0722));
        outC = vec3(clamp(0.5 + g, 0.0, 1.0));
    }
    imageStore(outputImage, px, vec4(mix(outC, src.rgb, blend), src.a));
}
