#version 450
// Threshold (Premiere Stylize) and Solarize share this shader.
//   [0] Mode (hidden): 0 Threshold, 1 Solarize
//   [1] Level (0-255): Threshold's cut point / Solarize's fold point
//   [2] Blend With Original (0-100 %)
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform writeonly image2D outputImage;
layout(binding = 1) uniform sampler2D inputImage;

layout(push_constant) uniform PushConstants {
    int   width;
    int   height;
    int   paramCount;
    int   _pad;
    float params[16];
} pc;

void main()
{
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= pc.width || px.y >= pc.height) return;
    vec2 uv  = (vec2(px) + 0.5) / vec2(pc.width, pc.height);
    vec4 src = texture(inputImage, uv);

    int   mode  = int(pc.params[0] + 0.5);
    float level = clamp(pc.params[1] / 255.0, 0.0, 1.0);
    float blend = clamp(pc.params[2] / 100.0, 0.0, 1.0);

    vec3 outC;
    if (mode == 1) {
        // Solarize: values above the fold point are inverted.
        outC = mix(src.rgb, 1.0 - src.rgb, step(vec3(level), src.rgb));
    } else {
        float luma = dot(src.rgb, vec3(0.2126, 0.7152, 0.0722));
        outC = vec3(step(level, luma));
    }
    imageStore(outputImage, px, vec4(mix(outC, src.rgb, blend), src.a));
}
