#version 450

// Premiere-style Tint:
//   params[0..2] = Map Black To (RGB, 0-1)
//   params[3..5] = Map White To (RGB, 0-1)
//   params[6]    = Amount to Tint (0-100 percent)

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform writeonly image2D outputImage;
layout(binding = 1) uniform sampler2D inputImage;

layout(push_constant) uniform PushConstants {
    int   width;
    int   height;
    int   paramCount;
    int   _pad;
    float params[28];
} pc;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= pc.width || pixel.y >= pc.height) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(pc.width, pc.height);
    vec4 source = texture(inputImage, uv);

    vec3 mapBlack = clamp(vec3(pc.params[0], pc.params[1], pc.params[2]), 0.0, 1.0);
    vec3 mapWhite = clamp(vec3(pc.params[3], pc.params[4], pc.params[5]), 0.0, 1.0);
    float amount = clamp(pc.params[6] / 100.0, 0.0, 1.0);

    float luminance = clamp(dot(source.rgb, vec3(0.2126, 0.7152, 0.0722)), 0.0, 1.0);
    vec3 mapped = mix(mapBlack, mapWhite, luminance);
    vec3 result = mix(source.rgb, mapped, amount);

    imageStore(outputImage, pixel, vec4(clamp(result, 0.0, 1.0), source.a));
}
