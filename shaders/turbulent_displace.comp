#version 450
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform writeonly image2D outputImage;
layout(binding = 1)        uniform sampler2D inputImage;

layout(push_constant) uniform PushConstants {
    int   width;
    int   height;
    int   paramCount;
    int   _pad;
    float params[16];
    // [0] intensity [1] scale [2] speed [3] complexity(octaves)
    // [15] clip-local seconds
} pc;

float hash21(vec2 p){ vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33); return fract((p3.x + p3.y) * p3.z); }

float vnoise(vec2 p)
{
    vec2 i = floor(p), f = fract(p);
    float a = hash21(i),            b = hash21(i + vec2(1, 0));
    float c = hash21(i + vec2(0,1)), d = hash21(i + vec2(1, 1));
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

float fbm(vec2 p, int oct)
{
    float v = 0.0, amp = 0.5;
    for (int i = 0; i < 5; ++i) {
        if (i >= oct) break;
        v += amp * vnoise(p);
        p *= 2.0; amp *= 0.5;
    }
    return v;
}

void main()
{
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= pc.width || px.y >= pc.height) return;

    vec2 uv = (vec2(px) + 0.5) / vec2(pc.width, pc.height);

    float intensity = pc.params[0];
    float scale     = pc.params[1];
    float speed     = pc.params[2];
    int   oct       = int(clamp(pc.params[3], 1.0, 5.0));
    float t         = pc.params[15];

    vec2 p  = uv * scale + vec2(0.0, t * speed);
    float nx = fbm(p, oct) - 0.5;
    float ny = fbm(p + vec2(5.2, 1.3), oct) - 0.5;

    vec2 suv = clamp(uv + vec2(nx, ny) * 0.1 * intensity, 0.0, 1.0);
    imageStore(outputImage, px, texture(inputImage, suv));
}
