#version 450
// YUV420P → BGRA color-space conversion compute shader.
//
// Takes YUV420P video frames (3 separate planes) and converts
// them to BGRA in a single GPU dispatch, eliminating the need for
// CPU-side sws_scale.
//
// YUV420P layout:
//   Plane 0 (Y):  W × H    bytes, one luma sample per pixel (R8)
//   Plane 1 (U):  W/2 × H/2 bytes, Cb chroma at half resolution (R8)
//   Plane 2 (V):  W/2 × H/2 bytes, Cr chroma at half resolution (R8)
//
// BT.709 color matrix (HD video standard):
//   R = Y + 1.5748 * Cr
//   G = Y - 0.1873 * Cb - 0.4681 * Cr
//   B = Y + 1.8556 * Cb

layout(local_size_x = 16, local_size_y = 16) in;

// Input planes
layout(binding = 0) uniform sampler2D yPlane;   // R8, full resolution
layout(binding = 1) uniform sampler2D uPlane;   // R8, half resolution (Cb)
layout(binding = 2) uniform sampler2D vPlane;   // R8, half resolution (Cr)

// Output BGRA image
layout(binding = 3, rgba8) uniform writeonly image2D outputImage;

// Push constants
layout(push_constant) uniform PushConstants {
    int width;
    int height;
} pc;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= pc.width || pixel.y >= pc.height) return;

    vec2 uv = (vec2(pixel) + 0.5) / vec2(pc.width, pc.height);

    // Sample Y (luma) at full resolution
    float y = texture(yPlane, uv).r;

    // Sample U and V (chroma) at half resolution — hardware bilinear
    // filtering gives free chroma upsampling.
    // Studio-swing chroma (16–240, neutral 128) is recentered (128/255 =
    // 0.50196) AND range-expanded (255/224 = 1.13839) to the full [-0.5,0.5]
    // the BT.709 coefficients assume.  Must match the CPU sws_scale path's
    // sws_setColorspaceDetails(BT709) limited→full expansion or frames from
    // the two decoders flicker. See nv12_to_bgra.comp for the full rationale.
    float cb = (texture(uPlane, uv).r - 0.50196) * 1.13839;
    float cr = (texture(vPlane, uv).r - 0.50196) * 1.13839;

    // BT.709 YCbCr → RGB conversion (HDTV standard)
    // Studio-swing luma scaling (16–235)
    float y_scaled = clamp((y - 0.0627) * 1.1644, 0.0, 1.0);

    float r = clamp(y_scaled + 1.5748 * cr,                        0.0, 1.0);
    float g = clamp(y_scaled - 0.1873 * cb - 0.4681 * cr,          0.0, 1.0);
    float b = clamp(y_scaled + 1.8556 * cb,                        0.0, 1.0);

    // Output as BGRA (matches Qt ARGB32 byte order on little-endian)
    imageStore(outputImage, pixel, vec4(b, g, r, 1.0));
}
