#version 450
// Distort effects sharing one shader; [0] is the hidden mode.
// Centres are -1..1 (0 = frame centre), like Vignette.
//   0 Twirl:           [1] Angle (deg)  [2] Radius (% of half-diagonal)  [3] Center X  [4] Center Y
//   1 Spherize:        [1] Amount (-100..100)  [2] Radius (%)  [3] Center X  [4] Center Y
//   2 Wave Warp:       [1] Wave Type (0 Sine, 1 Square, 2 Triangle, 3 Sawtooth)
//                      [2] Height (px)  [3] Width (px)  [4] Direction (deg)
//                      [5] Speed (cycles/s)  [6] Phase (deg)     [15] clip-local seconds
//   3 Lens Distortion: [1] Curvature (-100..100)  [2] Vertical Decentering  [3] Horizontal Decentering
//                      [4] Fill Alpha (toggle: outside the image is transparent, else edge colour)
//   4 Mirror:          [1] Reflection Center X  [2] Reflection Center Y  [3] Reflection Angle (deg)
//   5 Offset:          [1] Shift X (%)  [2] Shift Y (%)  [3] Blend With Original (0-100 %)
//   6 Replicate:       [1] Count (tiles per side)
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform writeonly image2D outputImage;
layout(binding = 1) uniform sampler2D inputImage;

layout(push_constant) uniform PushConstants {
    int   width;
    int   height;
    int   paramCount;
    int   _pad;
    float params[16];
} pc;

const float PI = 3.14159265358979;

vec2 centerPx(float cx, float cy, vec2 res) { return vec2(0.5 + 0.5 * cx, 0.5 + 0.5 * cy) * res; }

float wave(int type, float x)   // x in cycles
{
    float f = fract(x);
    if (type == 1) return f < 0.5 ? 1.0 : -1.0;
    if (type == 2) return 1.0 - 4.0 * abs(f - 0.5);
    if (type == 3) return 2.0 * f - 1.0;
    return sin(2.0 * PI * x);
}

void main()
{
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= pc.width || px.y >= pc.height) return;
    vec2 res = vec2(pc.width, pc.height);
    vec2 p   = vec2(px) + 0.5;           // pixel space
    vec2 uv  = p / res;
    int mode = int(pc.params[0] + 0.5);
    float halfDiag = 0.5 * length(res);

    vec2 sp = p;        // pixel to sample
    bool transparentOutside = false;
    vec4 blendWith = vec4(-1.0);

    if (mode == 0) {                                   // Twirl
        vec2 c = centerPx(pc.params[3], pc.params[4], res);
        float radius = max(pc.params[2] / 100.0 * halfDiag, 1.0);
        vec2 d = p - c;
        float r = length(d);
        if (r < radius) {
            float k = 1.0 - r / radius;
            float a = radians(pc.params[1]) * k * k;
            float cs = cos(a), sn = sin(a);
            sp = c + vec2(cs * d.x - sn * d.y, sn * d.x + cs * d.y);
        }
    } else if (mode == 1) {                            // Spherize
        vec2 c = centerPx(pc.params[3], pc.params[4], res);
        float radius = max(pc.params[2] / 100.0 * halfDiag, 1.0);
        float amount = clamp(pc.params[1] / 100.0, -1.0, 1.0);
        vec2 d = p - c;
        float r = length(d) / radius;
        if (r < 1.0 && r > 0.0) {
            // Bulge (amount > 0): exponent > 1 samples nearer the centre
            // (magnifies it); pinch (amount < 0): exponent < 1. Both keep
            // r = 0 and r = 1 fixed, so the sphere edge is seamless.
            float e = amount >= 0.0 ? 1.0 + amount : 1.0 + amount * 0.7;
            float nr = pow(r, e);
            sp = c + d * (nr / r);   // same direction, radius remapped r -> nr
        }
    } else if (mode == 2) {                            // Wave Warp
        int   type   = int(pc.params[1] + 0.5);
        float height = pc.params[2];
        float width  = max(pc.params[3], 1.0);
        float dirA   = radians(pc.params[4]);
        float speed  = pc.params[5];
        float phase  = pc.params[6] / 360.0;
        float t      = pc.params[15];
        vec2 dir  = vec2(cos(dirA), sin(dirA));          // displacement direction
        vec2 perp = vec2(-dir.y, dir.x);                 // wave travels along this
        float x = dot(p, perp) / width - speed * t + phase;
        sp = p + dir * height * wave(type, x);
    } else if (mode == 3) {                            // Lens Distortion
        float k  = pc.params[1] / 100.0;
        vec2 dec = vec2(pc.params[3], pc.params[2]) / 100.0;   // H, V
        vec2 c = res * 0.5 + dec * res * 0.5;
        vec2 d = (p - c) / halfDiag;
        float r2 = dot(d, d);
        // k > 0 barrel (bulge out), k < 0 pincushion.
        vec2 dd = d / (1.0 + k * r2 * 0.8);
        sp = c + dd * halfDiag;
        transparentOutside = pc.params[4] > 0.5;
    } else if (mode == 4) {                            // Mirror
        vec2 c = centerPx(pc.params[1], pc.params[2], res);
        float a = radians(pc.params[3]);
        vec2 n = vec2(cos(a), sin(a));                   // normal of the mirror line
        float side = dot(p - c, n);
        if (side > 0.0) sp = p - 2.0 * side * n;        // reflect the far side
    } else if (mode == 5) {                            // Offset (wraps around)
        vec2 shift = vec2(pc.params[1], pc.params[2]) / 100.0 * res;
        sp = mod(p - shift, res);
        blendWith = texture(inputImage, uv);
    } else if (mode == 6) {                            // Replicate
        float n = max(floor(pc.params[1] + 0.5), 1.0);
        sp = fract(uv * n) * res;
    }

    vec2 suv = sp / res;
    vec4 c;
    if (transparentOutside && (any(lessThan(suv, vec2(0.0))) || any(greaterThan(suv, vec2(1.0)))))
        c = vec4(0.0);
    else
        c = texture(inputImage, clamp(suv, 0.0, 1.0));
    if (mode == 5)
        c = mix(c, blendWith, clamp(pc.params[3] / 100.0, 0.0, 1.0));
    imageStore(outputImage, px, c);
}
