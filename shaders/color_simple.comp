#version 450
// Simple colour effects sharing one shader (mode is a hidden param):
//   Invert:        [0]=0  [1] Channel (0 RGB, 1 Red, 2 Green, 3 Blue, 4 Alpha, 5 Luma)
//                  [2] Blend With Original (0-100 %)
//   Black & White: [0]=1  [1] unused  [2] Blend With Original (0-100 %)
//   Leave Color:   [0]=2  [1] Amount to Decolor (0-100 %)  [2] unused
//                  [3..5] Color To Leave  [6] Tolerance (0-100 %)
//                  [7] Edge Softness (0-100 %)  [8] Match Colors (0 RGB, 1 Hue)
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform writeonly image2D outputImage;
layout(binding = 1) uniform sampler2D inputImage;

layout(push_constant) uniform PushConstants {
    int   width;
    int   height;
    int   paramCount;
    int   _pad;
    float params[16];
} pc;

vec3 rgb2hsv(vec3 c)
{
    vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
    vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
    float d = q.x - min(q.w, q.y);
    float e = 1.0e-10;
    return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

void main()
{
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= pc.width || px.y >= pc.height) return;
    vec2 uv  = (vec2(px) + 0.5) / vec2(pc.width, pc.height);
    vec4 src = texture(inputImage, uv);
    int mode = int(pc.params[0] + 0.5);
    float luma = dot(src.rgb, vec3(0.2126, 0.7152, 0.0722));
    vec4 outC = src;

    if (mode == 0) {
        int ch = int(pc.params[1] + 0.5);
        if (ch == 0)      outC.rgb = 1.0 - src.rgb;
        else if (ch == 1) outC.r = 1.0 - src.r;
        else if (ch == 2) outC.g = 1.0 - src.g;
        else if (ch == 3) outC.b = 1.0 - src.b;
        else if (ch == 4) outC.a = 1.0 - src.a;
        else              outC.rgb = clamp(src.rgb + (1.0 - 2.0 * luma), 0.0, 1.0);
        outC = mix(outC, src, clamp(pc.params[2] / 100.0, 0.0, 1.0));
    } else if (mode == 1) {
        outC.rgb = vec3(luma);
        outC = mix(outC, src, clamp(pc.params[2] / 100.0, 0.0, 1.0));
    } else {
        float amount = clamp(pc.params[1] / 100.0, 0.0, 1.0);
        vec3  keep   = vec3(pc.params[3], pc.params[4], pc.params[5]);
        float tol    = clamp(pc.params[6] / 100.0, 0.0, 1.0);
        float soft   = clamp(pc.params[7] / 100.0, 0.0, 1.0);
        bool  byHue  = pc.params[8] > 0.5;
        float dist;
        if (byHue) {
            vec3 a = rgb2hsv(src.rgb), b = rgb2hsv(keep);
            float dh = abs(a.x - b.x);
            dist = min(dh, 1.0 - dh) * 2.0;   // 0..1
            dist = mix(1.0, dist, smoothstep(0.02, 0.15, a.y));   // greys never match
        } else {
            dist = length(src.rgb - keep) / sqrt(3.0);
        }
        // 1 inside tolerance, fading to 0 across the softness band.
        float keepMask = 1.0 - smoothstep(tol, tol + max(soft, 1e-4), dist);
        float decolor = amount * (1.0 - keepMask);
        outC.rgb = mix(src.rgb, vec3(luma), decolor);
    }
    imageStore(outputImage, px, clamp(outC, 0.0, 1.0));
}
