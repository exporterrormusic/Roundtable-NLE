# Generated by Roundtable's top-level CMake configuration. Do not edit.
set(_roundtable_cuda_install_destination "${CMAKE_INSTALL_PREFIX}/bin")
set(_roundtable_cuda_install_executable
    "${_roundtable_cuda_install_destination}/roundtable.exe")

execute_process(
    COMMAND [==[@CMAKE_COMMAND@]==]
        "-DROUNDTABLE_CUDA_SEED_MANIFEST=@ROUNDTABLE_CUDA_SEED_MANIFEST@"
        "-DROUNDTABLE_CUDA_DESTINATION=${_roundtable_cuda_install_destination}"
        "-DROUNDTABLE_CUDA_EXECUTABLE=${_roundtable_cuda_install_executable}"
        "-DROUNDTABLE_CUDA_MODE=DEPLOY"
        -P [==[@CMAKE_SOURCE_DIR@/cmake/DeployCudaRuntime.cmake]==]
    RESULT_VARIABLE _roundtable_cuda_deploy_result)
if(NOT _roundtable_cuda_deploy_result EQUAL 0)
    message(FATAL_ERROR
        "Roundtable CUDA runtime install failed (${_roundtable_cuda_deploy_result})")
endif()

execute_process(
    COMMAND [==[@CMAKE_COMMAND@]==]
        "-DROUNDTABLE_CUDA_SEED_MANIFEST=@ROUNDTABLE_CUDA_SEED_MANIFEST@"
        "-DROUNDTABLE_CUDA_DESTINATION=${_roundtable_cuda_install_destination}"
        "-DROUNDTABLE_CUDA_EXECUTABLE=${_roundtable_cuda_install_executable}"
        "-DROUNDTABLE_CUDA_MODE=VERIFY"
        -P [==[@CMAKE_SOURCE_DIR@/cmake/DeployCudaRuntime.cmake]==]
    RESULT_VARIABLE _roundtable_cuda_verify_result)
if(NOT _roundtable_cuda_verify_result EQUAL 0)
    message(FATAL_ERROR
        "Roundtable CUDA runtime install verification failed (${_roundtable_cuda_verify_result})")
endif()
